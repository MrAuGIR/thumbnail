{
  "name": "mraugir/thumbnail",
  "type": "symfony-bundle",
  "description": "Eases the generation of thumbnail",
  "keywords": ["thumbnail","image","asset"],
  "license": "MIT",
  "authors": [
    {
      "name": "Aurélien Girard",
      "email": "mraugir.dev@gmail.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.2",
    "symfony/process": "^6.4 || ^7.0",
    "ext-fileinfo": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "symfony/browser-kit": "^6.4 || ^7.0"
  },
  "autoload": {
    "psr-4": {
      "MrAuGir\\Thumbnail\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MrAuGir\\Thumbnail\\Tests\\": "Tests/"
    }
  }
}
